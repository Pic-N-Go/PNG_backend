# docker-compose.prod.yml 실행에 필요한 환경변수 템플릿.
# 실제 값을 채운 뒤 .env.prod로 저장하세요(그 파일은 git에 안 올라갑니다).
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

DB_USERNAME=picngo
DB_PASSWORD=

# guest 계정은 localhost 외부에서 로그인이 거부되므로 반드시 guest가 아닌 값으로 채울 것.
# 이 값으로 RabbitMQ 브로커에도 동일한 계정이 새로 생성된다.
RABBITMQ_USERNAME=picngo
RABBITMQ_PASSWORD=

JWT_SECRET=

KAKAO_REST_API_KEY=
WEATHER_SERVICE_KEY=
PUBLIC_DATA_SERVICE_KEY=

MAIL_USERNAME=
MAIL_PASSWORD=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PRESIGNED_URL_EXPIRATION_MINUTES=10

WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://your-frontend-domain.com

GRAFANA_ADMIN_PASSWORD=
