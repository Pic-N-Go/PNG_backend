# docker-compose.prod.yml 실행에 필요한 환경변수 템플릿.
# 실제 값을 채운 뒤 .env.prod로 저장하세요(그 파일은 git에 안 올라갑니다).
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

DB_USERNAME=picngo
DB_PASSWORD=

# guest 계정은 localhost 외부에서 로그인이 거부되므로 반드시 guest가 아닌 값으로 채울 것.
# 이 값으로 RabbitMQ 브로커에도 동일한 계정이 새로 생성된다.
RABBITMQ_USERNAME=picngo
RABBITMQ_PASSWORD=

JWT_SECRET=

KAKAO_REST_API_KEY=
WEATHER_SERVICE_KEY=
PUBLIC_DATA_SERVICE_KEY=

MAIL_USERNAME=
MAIL_PASSWORD=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PRESIGNED_URL_EXPIRATION_MINUTES=10

WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://your-frontend-domain.com

GRAFANA_ADMIN_PASSWORD=

# ─── 검색 단계별 스위치 ───────────────────────────────────
# ⚠️ 켜기 전에 해당 마이그레이션을 먼저 적용해야 한다. 순서가 어긋나면
#    검색이 전부 실패하거나(FULLTEXT) 조용히 0건이 된다.
#    자세한 순서는 docs/deployment-checklist.md 참고.
#
# FULLTEXT로 두려면 docs/search-fulltext-index-migration.sql 선행 필요
SEARCH_ENGINE=LIKE
# 아래 둘은 docs/search-normalized-column-migration.sql 선행 필요
SEARCH_NORMALIZE_FALLBACK=false
SEARCH_SIMILAR_FALLBACK=false
# 편집거리 폴백. 색인을 쓰지 않아 마이그레이션 불필요
SEARCH_FUZZY_FALLBACK=false
# 의미 검색. OPENAI_API_KEY와 임베딩 백필이 함께 있어야 결과가 나온다
SEARCH_SEMANTIC_FALLBACK=false

# ─── 임베딩(의미 검색) ────────────────────────────────────
# 비워두면 의미 검색 단계는 항상 0건으로 끝난다(장애는 나지 않는다).
OPENAI_API_KEY=
# 아래 둘은 기본값이 있어 생략 가능
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings
