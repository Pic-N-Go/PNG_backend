# docker-compose.prod.yml 실행에 필요한 환경변수 템플릿.
# 실제 값을 채운 뒤 .env.prod로 저장하세요(그 파일은 git에 안 올라갑니다).
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

DB_USERNAME=picngo
DB_PASSWORD=

