{
  "title": "PicNGo AI 코스 플래너 & LLM 관측 대시보드",
  "description": "OpenAI Structured Outputs 호출 레이턴시, 토큰 사용량, 호출 상태 및 에러율을 실시간 모니터링하는 대시보드입니다.",
  "uid": "picngo-ai-orchestration",
  "tags": ["picngo", "ai", "llm", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "LLM API 호출 지연 시간 (p95 / 초)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_llm_call_duration_seconds_bucket[1m])) by (le, mode))",
          "legendFormat": "{{mode}} (p95)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      }
    },
    {
      "id": 2,
      "title": "분당 토큰 소비량 (Tokens / min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ai_llm_tokens_total[1m])) by (type) * 60",
          "legendFormat": "{{type}} tokens",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 3,
      "title": "LLM 호출 결과 상태 (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(ai_llm_call_count_total[1m])) by (status, mode)",
          "legendFormat": "{{mode}} - {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 4,
      "title": "평균 LLM 호출 소요 시간 (초)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(ai_llm_call_duration_seconds_sum[5m])) / sum(rate(ai_llm_call_duration_seconds_count[5m]))",
          "legendFormat": "평균 소요 시간",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2.0 },
              { "color": "red", "value": 5.0 }
            ]
          }
        }
      }
    }
  ]
}
